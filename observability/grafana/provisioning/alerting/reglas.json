                "expr": "min_over_time(traffic_intersection_state[10m])",
                "instant": true,
                "range": false,
                "intervalMs": 15000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        1.5
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "for": "0s",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
