{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "SGTU · Críticas",
      "folder": "SGTU",
      "interval": "30s",
      "rules": [
        {
          "uid": "svc-probe-caido",
          "title": "Servicio o base caída (probe)",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "min by (service, instance) (probe_success)",
                "instant": true,
                "range": false,
                "intervalMs": 15000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        1
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "for": "1m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "severity": "critical",
            "sistema": "sgtu"
          },
          "annotations": {
            "summary": "{{ $labels.service }} no responde ({{ $labels.instance }})",
            "description": "El probe de blackbox (/health con \"status\": \"ok\", o TCP para bases y brokers) falla hace más de 1 min.",
            "runbook": "1) Dashboard Salud técnica → 'Probes'. 2) docker compose ps / docker compose logs <servicio>. 3) Si es viz con 'degraded', mirar results-db. 4) Explore → Loki {service=\"<servicio>\"}.",
            "dashboard": "http://localhost:3001/d/sgtu-salud"
          },
          "isPaused": false
        },
        {
          "uid": "svc-scrape-caido",
          "title": "Target de Prometheus caído",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "max by (job, instance) (up{job!~\"blackbox.*\"})",
                "instant": true,
                "range": false,
                "intervalMs": 15000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        1
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "for": "1m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "severity": "critical",
            "sistema": "sgtu"
          },
          "annotations": {
            "summary": "Prometheus no puede leer /metrics de {{ $labels.job }} ({{ $labels.instance }})",
            "description": "up == 0 hace más de 1 min: el proceso no responde o la red interna falla.",
            "runbook": "1) Status → Targets en Prometheus (lastError). 2) docker compose ps. 3) Logs del servicio.",
            "dashboard": "http://localhost:3001/d/sgtu-salud"
          },
          "isPaused": false
        },
        {
          "uid": "cv-sin-workers",
          "title": "Sin workers de CV",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "count(up{job=\"cv-module\"} == 1) or vector(0)",
                "instant": true,
                "range": false,
                "intervalMs": 15000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        1
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "for": "30s",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "severity": "critical",
            "sistema": "sgtu"
          },
          "annotations": {
            "summary": "No hay ninguna réplica de cv-module viva",
            "description": "Prometheus no descubre ninguna réplica UP de cv-module: nadie procesa clips y la cola va a crecer.",
            "runbook": "1) docker compose ps cv-module. 2) docker compose up -d --scale cv-module=1. 3) Logs de la réplica (worker_stopped / worker_reconnecting).",
            "dashboard": "http://localhost:3001/d/sgtu-pipeline"
          },
          "isPaused": false
        },
        {
          "uid": "cola-sin-consumidores",
          "title": "camera_processing_queue sin consumidores",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "rabbitmq_detailed_queue_consumers{queue=\"camera_processing_queue\"}",
                "instant": true,
                "range": false,
                "intervalMs": 15000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        1
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "for": "1m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "severity": "critical",
            "sistema": "sgtu"
          },
          "annotations": {
            "summary": "camera_processing_queue no tiene consumidores",
            "description": "Ningún worker está suscrito a la cola de trabajo hace más de 1 min (worker caído o desconectado del broker).",
            "runbook": "1) Pipeline → 'Consumidores'. 2) Loki: {service=\"cv-module\", event=~\"worker_.*\"}. 3) Panel de RabbitMQ :15672 → Queues.",
            "dashboard": "http://localhost:3001/d/sgtu-pipeline"
          },
          "isPaused": false
        },
        {
          "uid": "camara-sin-datos",
          "title": "Cámara sin resultados",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "max by (camera_id, intersection_id) (time() - traffic_camera_last_result_timestamp_seconds)",
                "instant": true,
                "range": false,
                "intervalMs": 15000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        120
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "for": "30s",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "severity": "critical",
            "sistema": "sgtu"
          },
          "annotations": {
            "summary": "{{ $labels.camera_id }} ({{ $labels.intersection_id }}) sin resultados hace más de 2 min",
            "description": "Heartbeat de punta a punta desde results-db: la cámara no tiene resultados guardados recientes. Puede fallar el edge, la cola, el worker o la base.",
            "runbook": "1) Tránsito → tabla de cámaras. 2) ¿El edge publica? Pipeline → 'publicados vs procesados'. 3) Loki {service=\"edge-processor\"} |= \"<camera_id>\". 4) Seguir un clip_id en Jaeger.",
            "dashboard": "http://localhost:3001/d/sgtu-transito"
          },
          "isPaused": false
        },
        {
          "uid": "canary-falla",
          "title": "Monitoreo sintético fallando",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "min by (check) (canary_check_success)",
                "instant": true,
                "range": false,
                "intervalMs": 15000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        1
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "for": "1m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "severity": "critical",
            "sistema": "sgtu"
          },
          "annotations": {
            "summary": "El canary falla en el paso {{ $labels.check }}",
            "description": "El recorrido de usuario (login → intersecciones → health → logout) falla hace más de 1 min aunque los servicios puedan responder /health.",
            "runbook": "1) Salud técnica → 'Canary'. 2) docker logs canary (canary_check_failed con status). 3) RED de la API y Loki {service=\"api-rest\", level=\"ERROR\"}.",
            "dashboard": "http://localhost:3001/d/sgtu-salud"
          },
          "isPaused": false
        }
      ]
    },
    {
      "orgId": 1,
      "name": "SGTU · Advertencias",
      "folder": "SGTU",
      "interval": "30s",
      "rules": [
        {
          "uid": "cola-backlog",
          "title": "Backlog en camera_processing_queue",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "rabbitmq_detailed_queue_messages_ready{queue=\"camera_processing_queue\"}",
                "instant": true,
                "range": false,
                "intervalMs": 15000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        100
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "for": "2m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "severity": "warning",
            "sistema": "sgtu"
          },
          "annotations": {
            "summary": "La cola de trabajo tiene {{ $values.A }} mensajes listos",
            "description": "Más de 100 mensajes listos sostenido 2 min: entra más de lo que los workers procesan (P6/P9: con 1 worker y demora artificial crece ~2,5 msg/s).",
            "runbook": "1) Pipeline → 'publicados vs procesados' y 'Clips por réplica'. 2) Escalar: docker compose up -d --scale cv-module=3. 3) Revisar latencia por etapa (¿base lenta?).",
            "dashboard": "http://localhost:3001/d/sgtu-pipeline"
          },
          "isPaused": false
        },
        {
          "uid": "dlq-nuevos",
          "title": "Mensajes nuevos en camera_dlq",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "delta(rabbitmq_detailed_queue_messages{queue=\"camera_dlq\"}[5m])",
                "instant": true,
                "range": false,
                "intervalMs": 15000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "for": "0s",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "severity": "warning",
            "sistema": "sgtu"
          },
          "annotations": {
            "summary": "Llegaron mensajes a camera_dlq en los últimos 5 min",
            "description": "Clips que fallaron (parse/download/detect/db) y se mandaron a la DLQ sin reintentos (D12).",
            "runbook": "1) Pipeline → 'Fallos por etapa'. 2) Loki {event=\"clip_failed\"} | json → ver stage y error. 3) Seguir el trace_id en Jaeger. 4) rabbitmqadmin get queue=camera_dlq (header x-death).",
            "dashboard": "http://localhost:3001/d/sgtu-pipeline"
          },
          "isPaused": false
        },
        {
          "uid": "edge-lagging",
          "title": "Edge atrasado",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "max by (instance) (max_over_time(edge_lagging[2m]))",
                "instant": true,
                "range": false,
                "intervalMs": 15000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "for": "1m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "severity": "warning",
            "sistema": "sgtu"
          },
          "annotations": {
            "summary": "Una zona del edge tarda más que el intervalo entre clips",
            "description": "edge_lagging = 1: una ronda de un hilo superó FRAME_INTERVAL (5 s). Las cámaras de esa zona mandan clips con atraso.",
            "runbook": "1) Pipeline → 'Edge: duración de la ronda'. 2) CPU del edge (Salud técnica). 3) ¿publish_retry? (broker lento). 4) Repartir cámaras en más zonas (D10).",
            "dashboard": "http://localhost:3001/d/sgtu-pipeline"
          },
          "isPaused": false
        },
        {
          "uid": "latencia-e2e",
          "title": "Latencia extremo a extremo alta",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "histogram_quantile(0.95, sum by (le) (rate(worker_end_to_end_latency_seconds_bucket[5m])))",
                "instant": true,
                "range": false,
                "intervalMs": 15000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        30
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "for": "5m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "severity": "warning",
            "sistema": "sgtu"
          },
          "annotations": {
            "summary": "p95 de captura→guardado = {{ $values.A }} s",
            "description": "El dato del dashboard llega con más de 30 s de atraso (6 intervalos de captura). Normal: < 1 s.",
            "runbook": "1) ¿Hay backlog? Pipeline → cola. 2) Duración por etapa. 3) Una traza de clip lento en Jaeger (dónde se fue el tiempo).",
            "dashboard": "http://localhost:3001/d/sgtu-pipeline"
          },
          "isPaused": false
        },
        {
          "uid": "api-5xx",
          "title": "API: tasa de errores 5xx alta",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "sum(rate(http_requests_total{service=\"api-rest\",status=~\"5..\",route!~\"/metrics|/health\"}[5m])) / clamp_min(sum(rate(http_requests_total{service=\"api-rest\",route!~\"/metrics|/health\"}[5m])), 1e-9)",
                "instant": true,
                "range": false,
                "intervalMs": 15000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.05
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "for": "2m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "severity": "warning",
            "sistema": "sgtu"
          },
          "annotations": {
            "summary": "Más del 5 % de los requests de la API terminan en 5xx",
            "description": "Errores del lado del servidor (auth o viz caídos, base caída).",
            "runbook": "1) Salud técnica → 'Errores 5xx' y 'Llamadas a otros servicios'. 2) Loki {service=\"api-rest\", level=\"ERROR\"}. 3) Traza del request en Jaeger.",
            "dashboard": "http://localhost:3001/d/sgtu-salud"
          },
          "isPaused": false
        },
        {
          "uid": "api-latencia",
          "title": "API: latencia p95 alta",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{service=\"api-rest\",route!~\"/metrics|/health\"}[5m])))",
                "instant": true,
                "range": false,
                "intervalMs": 15000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        2
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "for": "5m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "severity": "warning",
            "sistema": "sgtu"
          },
          "annotations": {
            "summary": "p95 de la API = {{ $values.A }} s",
            "description": "La API tarda más de 2 s en el percentil 95.",
            "runbook": "1) Latencia p95 por ruta. 2) p95 por upstream (¿auth o viz?). 3) viz_query_duration_seconds. 4) Trazas lentas en Jaeger.",
            "dashboard": "http://localhost:3001/d/sgtu-salud"
          },
          "isPaused": false
        },
        {
          "uid": "pg-caido",
          "title": "PostgreSQL caído (exporter)",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "min by (service) (pg_up)",
                "instant": true,
                "range": false,
                "intervalMs": 15000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        1
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "for": "1m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "severity": "warning",
            "sistema": "sgtu"
          },
          "annotations": {
            "summary": "{{ $labels.service }}: postgres_exporter no puede conectarse",
            "description": "pg_up = 0: la base no acepta conexiones del exporter.",
            "runbook": "1) docker compose ps results-db auth-db. 2) docker compose logs <base>. 3) Probe TCP en Salud técnica.",
            "dashboard": "http://localhost:3001/d/sgtu-salud"
          },
          "isPaused": false
        },
        {
          "uid": "pg-conexiones",
          "title": "PostgreSQL: conexiones altas",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "sum by (service) (pg_stat_activity_count) / max by (service) (pg_settings_max_connections)",
                "instant": true,
                "range": false,
                "intervalMs": 15000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.8
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "for": "2m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "severity": "warning",
            "sistema": "sgtu"
          },
          "annotations": {
            "summary": "{{ $labels.service }} usa más del 80 % de max_connections",
            "description": "Cada request abre su conexión (sin pool): con mucha carga se puede agotar max_connections.",
            "runbook": "1) Conexiones a PostgreSQL. 2) ¿Muchas réplicas o requests? 3) Agregar pool de conexiones (trabajo futuro).",
            "dashboard": "http://localhost:3001/d/sgtu-salud"
          },
          "isPaused": false
        },
        {
          "uid": "minio-bucket",
          "title": "Bucket de clips muy grande",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "max(minio_bucket_usage_total_bytes{bucket=\"clips\"})",
                "instant": true,
                "range": false,
                "intervalMs": 15000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        5000000000.0
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "for": "5m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "severity": "warning",
            "sistema": "sgtu"
          },
          "annotations": {
            "summary": "El bucket clips ocupa más de 5 GB",
            "description": "No hay retención de clips (deuda conocida, D10/D17): el disco se va a llenar.",
            "runbook": "1) Tránsito → 'Bucket clips'. 2) Política de expiración (mc ilm) o borrar clips viejos ya procesados.",
            "dashboard": "http://localhost:3001/d/sgtu-transito"
          },
          "isPaused": false
        },
        {
          "uid": "contenedor-memoria",
          "title": "Contenedor cerca de su límite de memoria",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "max by (container_label_com_docker_compose_service) (container_memory_working_set_bytes{container_label_com_docker_compose_service!=\"\"} / (container_spec_memory_limit_bytes{container_label_com_docker_compose_service!=\"\"} > 0))",
                "instant": true,
                "range": false,
                "intervalMs": 15000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.85
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "for": "5m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "severity": "warning",
            "sistema": "sgtu"
          },
          "annotations": {
            "summary": "{{ $labels.container_label_com_docker_compose_service }} usa más del 85 % de su mem_limit",
            "description": "Requiere cAdvisor (perfil cadvisor). Solo aplica a contenedores con mem_limit.",
            "runbook": "1) Salud técnica → 'Memoria por contenedor'. 2) Subir mem_limit o bajar retención (Prometheus/Loki/Jaeger).",
            "dashboard": "http://localhost:3001/d/sgtu-salud"
          },
          "isPaused": false
        },
        {
          "uid": "canary-trabado",
          "title": "Canary sin ejecutar",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "time() - max(canary_last_run_timestamp_seconds)",
                "instant": true,
                "range": false,
                "intervalMs": 15000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        120
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "for": "1m",
          "noDataState": "Alerting",
          "execErrState": "Error",
          "labels": {
            "severity": "warning",
            "sistema": "sgtu"
          },
          "annotations": {
            "summary": "El canary no completa un recorrido hace más de 2 min",
            "description": "El contenedor canary está caído o trabado: el monitoreo sintético no está midiendo.",
            "runbook": "docker compose ps canary / docker logs canary.",
            "dashboard": "http://localhost:3001/d/sgtu-salud"
          },
          "isPaused": false
        }
      ]
    },
    {
      "orgId": 1,
      "name": "SGTU · Logs",
      "folder": "SGTU",
      "interval": "30s",
      "rules": [
        {
          "uid": "log-dead-lettered",
          "title": "Logs: clips enviados a la DLQ",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "datasourceUid": "loki",
              "model": {
                "refId": "A",
                "expr": "sum(count_over_time({event=\"clip_dead_lettered\"} [5m]))",
                "queryType": "instant",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "for": "0s",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "severity": "warning",
            "sistema": "sgtu"
          },
          "annotations": {
            "summary": "{{ $values.A }} clip_dead_lettered en los logs (5 min)",
            "description": "Alerta basada en LOGS (LogQL): el worker registró clips enviados a camera_dlq. Complementa la alerta por métricas de RabbitMQ.",
            "runbook": "1) Logs → evento clip_dead_lettered y clip_failed (| json → stage, error). 2) trace_hex → traza en Jaeger.",
            "dashboard": "http://localhost:3001/d/sgtu-logs"
          },
          "isPaused": false
        },
        {
          "uid": "log-logs-dropped",
          "title": "Logs: se descartaron logs en un servicio",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "loki",
              "model": {
                "refId": "A",
                "expr": "sum by (service) (count_over_time({event=\"logs_dropped\"} [10m]))",
                "queryType": "instant",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "for": "0s",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "severity": "warning",
            "sistema": "sgtu"
          },
          "annotations": {
            "summary": "{{ $labels.service }} descartó logs (buffer en memoria lleno)",
            "description": "Alerta basada en LOGS: logs-queue estuvo caído o lento y el buffer de 10 000 registros se llenó (D15). Las métricas derivadas de logs quedan bajas en ese período; stdout los conserva.",
            "runbook": "1) ¿logs-queue arriba? Salud técnica → probes. 2) Pipeline → logs_queue. 3) docker compose logs <servicio> (stdout tiene todo).",
            "dashboard": "http://localhost:3001/d/sgtu-logs"
          },
          "isPaused": false
        },
        {
          "uid": "log-errores",
          "title": "Logs: ráfaga de errores",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "datasourceUid": "loki",
              "model": {
                "refId": "A",
                "expr": "sum by (service) (count_over_time({level=\"ERROR\"} [5m]))",
                "queryType": "instant",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        20
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "for": "1m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "severity": "warning",
            "sistema": "sgtu"
          },
          "annotations": {
            "summary": "{{ $labels.service }}: {{ $values.A }} logs ERROR en 5 min",
            "description": "Muchos logs de nivel ERROR en un servicio (no solo un clip suelto).",
            "runbook": "Logs → filtrar Servicio y Nivel=ERROR; mirar el campo error y seguir la traza.",
            "dashboard": "http://localhost:3001/d/sgtu-logs"
          },
          "isPaused": false
        },
        {
          "uid": "pipeline-sin-consumir",
          "title": "monitoring-pipeline no consume logs_queue",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "max(pipeline_consumer_up) or vector(0)",
                "instant": true,
                "range": false,
                "intervalMs": 15000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        1
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "for": "1m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "severity": "warning",
            "sistema": "sgtu"
          },
          "annotations": {
            "summary": "El monitoring-pipeline no está consumiendo logs_queue",
            "description": "Sin consumidor, logs_queue crece hasta su límite (policy: 50 000 mensajes, después descarta los más viejos) y Loki deja de recibir logs.",
            "runbook": "1) docker compose logs monitoring-pipeline (pipeline_reconnecting). 2) Pipeline → logs_queue.",
            "dashboard": "http://localhost:3001/d/sgtu-pipeline"
          },
          "isPaused": false
        }
      ]
    },
    {
      "orgId": 1,
      "name": "SGTU · Negocio",
      "folder": "SGTU",
      "interval": "1m",
      "rules": [
        {
