          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rabbitmq_detailed_queue_consumers{queue=\"camera_processing_queue\"}",
          "refId": "C",
          "legendFormat": "consumidores"
