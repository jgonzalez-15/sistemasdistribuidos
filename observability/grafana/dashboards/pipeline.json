  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      },
      "options": {
        "mode": "markdown",
        "content": "**Pipeline de procesamiento** — público: desarrollo. Edge → MinIO → `camera_processing_queue` → cv-module → results-db. Si entra más de lo que sale, la cola crece; si algo falla, va a `camera_dlq`."
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "Flujo: lo que entra vs lo que sale",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Clips publicados vs procesados (por segundo)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(edge_clips_published_total[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "publicados (edge)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(worker_clips_total{result=~\"ok|duplicate\"}[$__rate_interval]))",
          "refId": "B",
          "legendFormat": "procesados (workers)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(worker_clips_total{result=\"failed\"}[$__rate_interval]))",
          "refId": "C",
          "legendFormat": "fallidos"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "camera_processing_queue: listos, sin ACK y consumidores",
