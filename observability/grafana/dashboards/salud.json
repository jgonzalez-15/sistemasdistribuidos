    {
      "id": 10,
      "type": "timeseries",
      "title": "Errores 5xx (% de requests)",
      "description": "Alerta: > 5 % sostenido. La serie B muestra 401/403 por segundo (accesos denegados).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 15,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (sum(rate(http_requests_total{service=\"api-rest\",status=~\"5..\",route!~\"/metrics|/health\"}[5m])) or vector(0)) / clamp_min(sum(rate(http_requests_total{service=\"api-rest\",route!~\"/metrics|/health\"}[5m])), 1e-9)",
          "refId": "A",
          "legendFormat": "5xx %"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status) (rate(http_requests_total{service=\"api-rest\",status=~\"4..\",route!~\"/metrics|/health\"}[5m]))",
          "refId": "B",
          "legendFormat": "{{status}}/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
