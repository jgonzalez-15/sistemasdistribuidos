# Application Ports
API_REST_PORT=8000
EDGE_PROCESSOR_PORT=8001
VISUALIZATION_BACKEND_PORT=8003
MONITORING_PIPELINE_PORT=8004
AUTH_SERVICE_PORT=8005
FRONTEND_PORT=3000

# Camera Processing Queue (RabbitMQ Container 1)
CAMERA_QUEUE_HOST=camera-queue
CAMERA_QUEUE_HOST_PORT=5672
CAMERA_QUEUE_MANAGEMENT_PORT=15672
CAMERA_QUEUE_USER=guest
CAMERA_QUEUE_PASS=guest
CAMERA_QUEUE_NAME=camera_processing_queue

# Logs Queue (RabbitMQ Container 2)
LOGS_QUEUE_HOST=logs-queue
LOGS_QUEUE_HOST_PORT=5673
LOGS_QUEUE_MANAGEMENT_PORT=15673
LOGS_QUEUE_USER=guest
LOGS_QUEUE_PASS=guest
LOGS_QUEUE_NAME=logs_queue

# Auth DB (PostgreSQL)
AUTH_DB_HOST=auth-db
AUTH_DB_HOST_PORT=5433
AUTH_DB_NAME=auth_db
AUTH_DB_USER=postgres
AUTH_DB_PASS=postgres

# Results DB (PostgreSQL)
RESULTS_DB_HOST=results-db
RESULTS_DB_HOST_PORT=5434
RESULTS_DB_NAME=results_db
RESULTS_DB_USER=postgres
RESULTS_DB_PASS=postgres

# Clips DB (MinIO Object Storage)
CLIPS_DB_ENDPOINT=http://clips-db:9000
CLIPS_DB_API_PORT=9000
CLIPS_DB_CONSOLE_PORT=9001
CLIPS_DB_ACCESS_KEY=minioadmin
CLIPS_DB_SECRET_KEY=minioadmin
CLIPS_BUCKET_NAME=clips

# Internal/External Service Discovery URLs (Change IPs/Hosts when deploying on separate machines)
API_REST_URL=http://api-rest:8000
EDGE_PROCESSOR_URL=http://edge-processor:8001
CV_MODULE_URL=http://cv-module:8002
VISUALIZATION_BACKEND_URL=http://visualization-backend:8003
MONITORING_PIPELINE_URL=http://monitoring-pipeline:8004
AUTH_SERVICE_URL=http://auth-service:8005

# Browser-facing URLs for React Frontend
VITE_API_REST_URL=http://localhost:8000
VITE_AUTH_SERVICE_URL=http://localhost:8005
VITE_VISUALIZATION_BACKEND_URL=http://localhost:8003

# ---------------------------------------------------------------------------
# Observabilidad (perfil `observability`: docker compose --profile observability up -d --build)
# ---------------------------------------------------------------------------
# GET /metrics en cada servicio Python (false = métricas apagadas, el servicio sigue igual)
METRICS_ENABLED=true
# MinIO expone /minio/v2/metrics/* sin token (solo desarrollo)
MINIO_PROMETHEUS_AUTH_TYPE=public
# Prometheus: puerto en el host y retención corta (laptops)
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=3d
PROMETHEUS_RETENTION_SIZE=1GB
# Monitoreo sintético (canary): usuario de desarrollo del seed de auth-db
CANARY_USER=admin
CANARY_PASSWORD=admin123
CANARY_INTERVAL_S=30
# Grafana (dashboards + alertas provisionados). Puerto 3001: el 3000 es del frontend.
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# Contact point de las alertas (webhook). Por defecto, el receptor local alert-receiver.
ALERT_WEBHOOK_URL=http://alert-receiver:8080/alert
# Metrics DB del monitoring-pipeline (agregados por minuto)
METRICS_DB_HOST=metrics-db
METRICS_DB_HOST_PORT=5435
METRICS_DB_NAME=metrics_db
METRICS_DB_USER=postgres
METRICS_DB_PASS=postgres
# Loki (logs centralizados): destino del pipeline, puerto en el host y retención
LOKI_URL=http://loki:3100
LOKI_PORT=3100
LOKI_RETENTION=48h
# Link "Observabilidad (Grafana)" de la vista Sistema del frontend
VITE_GRAFANA_URL=http://localhost:3001
